# Public site URL used for canonical links and sitemap entries.
NEXT_PUBLIC_SITE_URL=https://lunglearn.com

# Required in production. Session cookies are HMAC-bound to this value.
SESSION_SECRET=

# 32-byte key, base64. Encrypts verification files and TOTP secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Comma-separated emails that may register as administrators.
ADMIN_EMAILS=

# Stripe. Leave blank until the billing account is approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_STANDARD=
# Set to true only after Stripe Tax is configured on the account.
STRIPE_AUTOMATIC_TAX=false

# Optional grounded tutor. Off unless both values are set.
AI_TUTOR_ENABLED=false
AI_TUTOR_BASE_URL=
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=
# Daily token budget for the optional tutor.
AI_TUTOR_DAILY_TOKEN_BUDGET=20000

# Optional Postgres. The file store is used when this is unset.
DATABASE_URL=

# Directory for the local file store. Defaults to ./.data
DATA_DIR=
